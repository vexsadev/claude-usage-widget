#!/usr/bin/env python3
"""Claude Code compact usage widget (always-on-top, all workspaces).

Shows the 5-hour and weekly plan limits (captured by ~/.local/bin/claude-statusline)
and today's token usage per model (from ~/.claude/projects/**/*.jsonl), live.
Desktop notifications fire at 80% and 90% of each limit, once per reset window.

Left-drag to move · "–" minimizes to the tray · right-click for menu.
Running the command again (or the app-menu entry) brings the widget back.
"""
import os
os.environ.setdefault("GDK_BACKEND", "x11")  # XWayland: lets keep-above/sticky/move work on GNOME Wayland

import glob
import json
import math
import subprocess
import time
from collections import deque
from datetime import datetime

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Gio  # noqa: E402
import cairo  # noqa: E402

Indicator = None
for _ns in ("AyatanaAppIndicator3", "AppIndicator3"):
    try:
        gi.require_version(_ns, "0.1")
        Indicator = getattr(__import__("gi.repository", fromlist=[_ns]), _ns)
        break
    except (ValueError, ImportError):
        pass

PROJECTS = os.path.expanduser("~/.claude/projects")
CONF = os.path.expanduser("~/.config/claude-token-widget.json")
CACHE = os.path.expanduser("~/.cache/claude-token-widget")
RATE_FILE = os.path.join(CACHE, "rate_limits.json")
NOTIFY_FILE = os.path.join(CACHE, "notified.json")
REFRESH_MS = 2000
RESCAN_S = 10
KEEP_S = 26 * 3600
THRESHOLDS = (80, 90)
MAX_MODELS = 4
LIVE_S = 120

BG = (0.08, 0.09, 0.11)
DEFAULT_OPACITY = 0.62
ICON_DIR = os.path.join(CACHE, "icons")
FG = (0.92, 0.93, 0.95)
DIM = (0.58, 0.61, 0.66)
ACCENT = (0.85, 0.47, 0.34)


def fmt(n):
    n = float(n)
    for unit, div in (("B", 1e9), ("M", 1e6), ("k", 1e3)):
        if abs(n) >= div:
            v = n / div
            return f"{v:.1f}{unit}" if v < 100 else f"{v:.0f}{unit}"
    return f"{int(n)}"


def fmt_dur(sec):
    sec = max(0, int(sec))
    d, r = divmod(sec, 86400)
    h, r = divmod(r, 3600)
    m = r // 60
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m:02d}m"
    return f"{m}m"


def parse_ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


# API list prices, USD per million tokens: (input, output, cache read).
# Cache writes: 1.25x input (5-minute TTL), 2x input (1-hour TTL). Fast mode: 2x everything.
# Source: Claude API pricing as of 2026-11. Longest prefix match wins.
PRICES = {
    "claude-fable-5-2": (8.0, 40.0, 0.20), "claude-mythos-5-2": (8.0, 40.0, 0.20),
    "claude-fable-5-1": (10.0, 50.0, 0.25), "claude-mythos-5-1": (10.0, 50.0, 0.25),
    "claude-fable-5": (10.0, 50.0, 1.00), "claude-mythos-5": (10.0, 50.0, 1.00),
    "claude-opus-5-5": (4.0, 20.0, 0.20),
    "claude-opus-5": (5.0, 25.0, 0.50),
    "claude-opus-4-8": (5.0, 25.0, 0.50), "claude-opus-4-7": (5.0, 25.0, 0.50),
    "claude-opus-4-6": (5.0, 25.0, 0.50),
    "claude-sonnet-5-5": (2.0, 10.0, 0.10),
    "claude-sonnet-5": (2.0, 10.0, 0.20),
    "claude-sonnet-4-6": (3.0, 15.0, 0.30),
    "claude-haiku-5-5": (0.10, 0.50, 0.01),
    "claude-haiku-4-5": (1.0, 5.0, 0.10),
}
HAIKU55_LONG = (0.50, 2.50, 0.05)  # Haiku 5.5 prompts over 100K tokens


def request_cost(model, u):
    """API-equivalent USD cost of one request's usage block, or None if the model is unpriced."""
    price = None
    for k in sorted(PRICES, key=len, reverse=True):
        if model.startswith(k):
            price = PRICES[k]
            break
    if price is None:
        return None
    inp = int(u.get("input_tokens") or 0)
    out = int(u.get("output_tokens") or 0)
    cr = int(u.get("cache_read_input_tokens") or 0)
    cw = int(u.get("cache_creation_input_tokens") or 0)
    cc = u.get("cache_creation") if isinstance(u.get("cache_creation"), dict) else {}
    w1h = int(cc.get("ephemeral_1h_input_tokens") or 0)
    w5m = max(0, cw - w1h)
    if model.startswith("claude-haiku-5-5") and inp + cr + cw > 100_000:
        price = HAIKU55_LONG
    pin, pout, pcr = price
    usd = (inp * pin + out * pout + cr * pcr + w5m * pin * 1.25 + w1h * pin * 2.0) / 1e6
    if u.get("speed") == "fast":
        usd *= 2
    return usd


def fmt_usd(v):
    if v >= 100:
        return f"${v:.0f}"
    if v >= 10:
        return f"${v:.1f}"
    return f"${v:.2f}"


def tray_color(p):
    """Limit colors (bars, tray, pills): green < 80%, yellow 80-89%, red >= 90%."""
    if p is None:
        return DIM
    if p >= 90:
        return (0.97, 0.44, 0.47)   # soft rose
    if p >= 80:
        return (0.98, 0.78, 0.33)   # warm amber
    return (0.29, 0.83, 0.62)       # mint / emerald


EXT_UUID = "claude-usage@local"


def shell_extension_active():
    """True when the Claude Usage GNOME Shell extension is drawing the top-bar pills."""
    try:
        out = subprocess.run(["gnome-extensions", "info", EXT_UUID], capture_output=True,
                             text=True, timeout=3).stdout
        return "State: ACTIVE" in out
    except Exception:
        return False


def model_name(m):
    m = (m or "").replace("claude-", "")
    parts = m.split("-")
    # opus-5-5 -> Opus 5.5 ; haiku-5-5-20261001 -> Haiku 5.5
    if parts and parts[0].isalpha():
        nums = [p for p in parts[1:] if p.isdigit() and len(p) <= 2]
        return (parts[0].capitalize() + " " + ".".join(nums)).strip()
    return m or "unknown"


def load_limits():
    try:
        with open(RATE_FILE) as f:
            d = json.load(f)
    except Exception:
        return None
    rl = d.get("rate_limits") or {}
    now = time.time()
    out = []
    for key, label in (("five_hour", "5-hour"), ("seven_day", "Weekly")):
        v = rl.get(key)
        if not isinstance(v, dict) or not isinstance(v.get("used_percentage"), (int, float)):
            continue
        pct = float(v["used_percentage"])
        reset = v.get("resets_at")
        if isinstance(reset, str):
            reset = parse_ts(reset)
        if reset and now >= reset:
            pct, reset = 0.0, None  # window rolled over since the last capture
        out.append((key, label, pct, reset))
    return out or None


class Notifier:
    def __init__(self):
        try:
            with open(NOTIFY_FILE) as f:
                self.state = json.load(f)
        except Exception:
            self.state = {}

    def check(self, limits):
        changed = False
        for key, label, pct, reset in limits or ():
            if reset is None:
                continue
            st = self.state.get(key)
            if not st or st.get("reset") != reset:
                st = {"reset": reset, "level": 0}
                self.state[key] = st
                changed = True
            hit = [t for t in THRESHOLDS if pct >= t and st["level"] < t]
            if hit:
                t = max(hit)
                st["level"] = t
                changed = True
                self.send(label, pct, reset, t)
        if changed:
            try:
                os.makedirs(CACHE, exist_ok=True)
                with open(NOTIFY_FILE, "w") as f:
                    json.dump(self.state, f)
            except Exception:
                pass

    @staticmethod
    def send(label, pct, reset, level):
        urgency = "critical" if level >= 90 else "normal"
        body = f"{pct:.0f}% used · resets in {fmt_dur(reset - time.time())}"
        try:
            subprocess.Popen(["notify-send", "-a", "Claude Usage", "-u", urgency,
                              "-i", "dialog-warning", f"Claude {label} limit at {level}%", body])
        except Exception as e:
            print("notify failed:", e)


class Tracker:
    def __init__(self):
        self.offsets = {}
        self.seen = set()
        self.events = deque()  # (ts, total, out, model, cost_usd or None)
        self.last_scan = 0

    def scan(self):
        now = time.time()
        if now - self.last_scan < RESCAN_S and self.offsets:
            paths = list(self.offsets)
        else:
            self.last_scan = now
            paths = glob.glob(os.path.join(PROJECTS, "**", "*.jsonl"), recursive=True)
        for p in paths:
            try:
                st = os.stat(p)
            except OSError:
                self.offsets.pop(p, None)
                continue
            off = self.offsets.get(p)
            if off is None:
                if st.st_mtime < now - KEEP_S:
                    self.offsets[p] = st.st_size
                    continue
                off = 0
            if st.st_size < off:
                off = 0
            if st.st_size == off:
                self.offsets[p] = off
                continue
            with open(p, "rb") as fh:
                fh.seek(off)
                data = fh.read()
            end = data.rfind(b"\n")
            if end < 0:
                continue
            self.offsets[p] = off + end + 1
            for line in data[: end + 1].splitlines():
                self._line(line)
        cutoff = now - KEEP_S
        while self.events and self.events[0][0] < cutoff:
            self.events.popleft()

    def _line(self, line):
        if b'"usage"' not in line:
            return
        try:
            d = json.loads(line)
        except Exception:
            return
        m = d.get("message")
        if not isinstance(m, dict) or not isinstance(m.get("usage"), dict):
            return
        model = m.get("model") or ""
        if not model or model.startswith("<"):
            return
        key = (m.get("id"), d.get("requestId"))
        if key != (None, None):
            if key in self.seen:
                return
            self.seen.add(key)
        ts = parse_ts(d.get("timestamp", ""))
        if ts is None:
            return
        u = m["usage"]
        out = int(u.get("output_tokens") or 0)
        total = out + sum(int(u.get(k) or 0) for k in
                          ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
        ev = (ts, total, out, model, request_cost(model, u))
        if self.events and ts < self.events[-1][0]:
            lst = sorted([*self.events, ev], key=lambda e: e[0])
            self.events = deque(lst)
        else:
            self.events.append(ev)

    def per_model(self):
        """Today's usage per model: [(name, total, cost, last_ts, priced)], busiest first."""
        midnight = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
        agg = {}
        for ts, total, _out, model, cost in self.events:
            if ts < midnight:
                continue
            name = model_name(model)
            a = agg.setdefault(name, [0, 0.0, 0, True])
            a[0] += total
            if cost is None:
                a[3] = False
            else:
                a[1] += cost
            a[2] = max(a[2], ts)
        rows = [(n, a[0], a[1], a[2], a[3]) for n, a in agg.items()]
        rows.sort(key=lambda r: -r[1])
        return rows


class Widget(Gtk.Window):
    W = 230

    def __init__(self, app):
        super().__init__(title="Claude Usage", application=app)
        self.app = app
        self.tracker = Tracker()
        self.notifier = Notifier()
        self.models = []
        self.limits = None
        self.conf = self._load_conf()
        self.H = self.calc_h()

        self.set_decorated(False)
        self.set_keep_above(True)
        self.stick()
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_type_hint(Gdk.WindowTypeHint.UTILITY)
        self.set_accept_focus(False)
        self.set_resizable(False)
        self.set_size_request(self.W, self.H)
        self.set_app_paintable(True)
        vis = self.get_screen().get_rgba_visual()
        if vis:
            self.set_visual(vis)

        self.area = Gtk.DrawingArea()
        self.area.connect("draw", self.on_draw)
        self.add(self.area)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self.on_press)
        self.connect("configure-event", self.on_configure)
        self.connect("delete-event", lambda *_: self.minimize() or True)

        self.menu = Gtk.Menu()
        for label, cb in (("Minimize", lambda *_: self.minimize()),
                          ("Refresh now", lambda *_: self.tick()),
                          ("Test notification", lambda *_: Notifier.send("5-hour", 80, time.time() + 3600, 80)),
                          ("Reset position", lambda *_: self.reset_pos()),
                          ("Quit", lambda *_: self.app.quit())):
            it = Gtk.MenuItem(label=label)
            it.connect("activate", cb)
            self.menu.append(it)
        op_item = Gtk.MenuItem(label="Opacity")
        sub = Gtk.Menu()
        group = None
        for val in (0.35, 0.5, 0.62, 0.8, 0.95):
            r = Gtk.RadioMenuItem.new_with_label_from_widget(group, f"{int(val * 100)}%")
            group = r
            if abs(self.conf.get("opacity", DEFAULT_OPACITY) - val) < 0.01:
                r.set_active(True)
            r.connect("toggled", self.on_opacity, val)
            sub.append(r)
        op_item.set_submenu(sub)
        self.menu.insert(op_item, 2)
        self.menu.show_all()

        self.tray = self.make_tray()
        self.move_to_saved()
        if self.conf.get("hidden") and self.tray:
            self.area.show()
        else:
            self.restore()
        self.tick()
        GLib.timeout_add(REFRESH_MS, self.tick)
        GLib.timeout_add_seconds(30, self._reassert)
        self.ext_active = None
        self._sync_tray_mode()
        GLib.timeout_add_seconds(30, self._sync_tray_mode)

    def on_opacity(self, item, val):
        if item.get_active():
            self.conf["opacity"] = val
            self._save_conf()
            self.area.queue_draw()

    # ---- minimize / tray ----
    def tray_pill(self, text, pct):
        """Render the whole tray item as a rounded pill image; returns its absolute PNG path.

        Style: dark glassy base tinted with the status color, a fill showing % used,
        a thin colored border and light tinted text. The Ubuntu AppIndicator extension
        shows images at least 1.5x wider than tall at their own pixel size.
        """
        gi.require_version("PangoCairo", "1.0")
        from gi.repository import Pango, PangoCairo
        import hashlib
        c = tray_color(pct)
        key = f"v2|{text}|{c}|{pct}"
        path = os.path.join(ICON_DIR, "pill-" + hashlib.md5(key.encode()).hexdigest()[:12] + ".png")
        if os.path.exists(path):
            return path
        os.makedirs(ICON_DIR, exist_ok=True)
        H, PAD, R = 24, 11, 12
        font = Pango.FontDescription.from_string("Sans Bold 10")

        def mk_layout(ctx):
            lay = PangoCairo.create_layout(ctx)
            lay.set_font_description(font)
            lay.set_text(text, -1)
            return lay

        _ink, logical = mk_layout(cairo.Context(cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1))).get_pixel_extents()
        W = max(int(H * 1.6), logical.width + 2 * PAD)
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, W, H)
        cr = cairo.Context(surf)
        # base: dark glass with a light tint of the status color
        self.rrect(cr, 0.5, 0.5, W - 1, H - 1, R - 0.5)
        cr.set_source_rgba(0.10, 0.11, 0.13, 0.78)
        cr.fill_preserve()
        cr.set_source_rgba(*c, 0.12)
        cr.fill()
        # usage fill (left to right), clipped to the pill shape
        if pct:
            cr.save()
            self.rrect(cr, 0.5, 0.5, W - 1, H - 1, R - 0.5)
            cr.clip()
            fw = (W - 1) * min(100.0, max(0.0, pct)) / 100.0
            grad = cairo.LinearGradient(0, 0, fw, 0)
            grad.add_color_stop_rgba(0, *c, 0.10)
            grad.add_color_stop_rgba(1, *c, 0.30)
            cr.rectangle(0.5, 0.5, fw, H - 1)
            cr.set_source(grad)
            cr.fill()
            cr.restore()
        # thin border in the status color
        self.rrect(cr, 1, 1, W - 2, H - 2, R - 1)
        cr.set_line_width(1.2)
        cr.set_source_rgba(*c, 0.55)
        cr.stroke()
        # text: status color blended toward white
        tc = tuple(x + (1 - x) * 0.45 for x in c)
        lay = mk_layout(cr)
        cr.set_source_rgb(*tc)
        cr.move_to((W - logical.width) / 2, (H - logical.height) / 2)
        PangoCairo.show_layout(cr, lay)
        surf.write_to_png(path + ".tmp")
        os.replace(path + ".tmp", path)
        return path

    def tray_icon(self, pct):
        """Render a colored badge with the 5-hour % and return its icon name."""
        key = "none" if pct is None else str(int(round(pct)))
        name = f"claude-tray-{key}"
        path = os.path.join(ICON_DIR, name + ".png")
        if not os.path.exists(path):
            os.makedirs(ICON_DIR, exist_ok=True)
            S = 64
            surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, S, S)
            cr = cairo.Context(surf)
            self.rrect(cr, 2, 2, S - 4, S - 4, 14)
            cr.set_source_rgb(*tray_color(pct))
            cr.fill()
            txt = "–" if pct is None else key
            cr.select_font_face("Sans", 0, 1)
            cr.set_font_size({1: 40, 2: 36, 3: 26}.get(len(txt), 26))
            e = cr.text_extents(txt)
            cr.move_to((S - e.width) / 2 - e.x_bearing, (S - e.height) / 2 - e.y_bearing)
            cr.set_source_rgb(*((0.11, 0.09, 0.0) if pct is not None and 80 <= pct < 90 else (1, 1, 1)))
            cr.show_text(txt)
            surf.write_to_png(path)
        return name
    TRAY_ITEMS = (("five_hour", "5h", "5-hour"), ("seven_day", "wk", "Weekly"))

    def make_tray(self):
        """One tray indicator per limit, each with a colored % badge and the same menu."""
        if Indicator is None:
            return None
        os.makedirs(ICON_DIR, exist_ok=True)
        self.tray_parts = []
        for key, short, name in self.TRAY_ITEMS:
            ind = Indicator.Indicator.new(f"claude-usage-{key}", "utilities-system-monitor-symbolic",
                                          Indicator.IndicatorCategory.APPLICATION_STATUS)
            ind.set_icon_theme_path(ICON_DIR)
            ind.set_status(Indicator.IndicatorStatus.ACTIVE)
            ind.set_title(f"Claude {name} limit")
            menu = Gtk.Menu()
            toggle = Gtk.MenuItem(label="Show widget")
            toggle.connect("activate", lambda *_: self.toggle())
            info = {k: Gtk.MenuItem(label=f"{n}: –") for k, _s, n in self.TRAY_ITEMS}
            quit_it = Gtk.MenuItem(label="Quit")
            quit_it.connect("activate", lambda *_: self.app.quit())
            menu.append(toggle)
            menu.append(Gtk.SeparatorMenuItem())
            for it in info.values():
                it.set_sensitive(False)
                menu.append(it)
            menu.append(Gtk.SeparatorMenuItem())
            menu.append(quit_it)
            menu.show_all()
            ind.set_menu(menu)
            ind.set_secondary_activate_target(toggle)  # middle-click toggles
            self.tray_parts.append({"key": key, "short": short, "name": name, "ind": ind,
                                    "toggle": toggle, "info": info, "icon": None})
        return self.tray_parts

    def _sync_tray_mode(self):
        """Hide the AppIndicator badges while the GNOME Shell extension shows the colored pills."""
        active = shell_extension_active()
        if active != self.ext_active and self.tray:
            self.ext_active = active
            status = (Indicator.IndicatorStatus.PASSIVE if active else Indicator.IndicatorStatus.ACTIVE)
            for part in self.tray_parts:
                part["ind"].set_status(status)
        return True

    def update_tray(self):
        if not self.tray:
            return
        lim = {k: (p, r) for k, _l, p, r in (self.limits or ())}
        now = time.time()
        texts = {}
        for key, _short, name in self.TRAY_ITEMS:
            if key in lim:
                p, r = lim[key]
                texts[key] = f"{name}: {p:.0f}%" + (f" · resets {fmt_dur(r - now)}" if r else "")
        shown = self.get_visible() and not self.conf.get("hidden")
        for part in self.tray_parts:
            pct = lim[part["key"]][0] if part["key"] in lim else None
            reset = lim[part["key"]][1] if part["key"] in lim else None
            warn = "⚠ " if pct is not None and pct >= 95 else ""
            text = (f"{warn}{pct:.0f}% {part['short']}" if pct is not None else f"– {part['short']}") \
                + (f" · {fmt_dur(reset - now)}" if reset else "")
            icon = self.tray_pill(text, pct)
            if icon != part["icon"]:
                old = part.get("old_icon")
                part["old_icon"], part["icon"] = part["icon"], icon
                part["ind"].set_label("", "")
                part["ind"].set_icon_full(icon, f"Claude {part['name']} usage")
                if old and old not in (icon, part["old_icon"]):
                    try:
                        os.remove(old)  # keep the previous image around while the shell loads the new one
                    except OSError:
                        pass
            for k, it in part["info"].items():
                if k in texts:
                    it.set_label(texts[k])
            part["toggle"].set_label("Hide widget" if shown else "Show widget")

    def minimize(self):
        if self.tray or self.ext_active:
            self.hide()
        else:
            self.iconify()  # no tray available: fall back to a normal minimize
        self.conf["hidden"] = True
        self._save_conf()
        self.update_tray()

    def restore(self):
        self.show_all()
        self.deiconify()
        self.move_to_saved()
        self.set_keep_above(True)
        self.stick()
        self.conf["hidden"] = False
        self._save_conf()
        self.update_tray()

    def toggle(self):
        if self.get_visible() and not self.conf.get("hidden"):
            self.minimize()
        else:
            self.restore()

    def calc_h(self):
        rows = max(1, min(MAX_MODELS, len(self.models)))
        return 118 + rows * 18

    # ---- config / position ----
    def _load_conf(self):
        try:
            with open(CONF) as f:
                return json.load(f)
        except Exception:
            return {}

    def _save_conf(self):
        try:
            with open(CONF, "w") as f:
                json.dump(self.conf, f)
        except Exception:
            pass
        return False

    def default_pos(self):
        disp = Gdk.Display.get_default()
        mon = disp.get_primary_monitor() or disp.get_monitor(0)
        g = mon.get_workarea()
        return g.x + g.width - self.W - 20, g.y + 20

    def move_to_saved(self):
        x, y = self.conf.get("x"), self.conf.get("y")
        if x is None or y is None:
            x, y = self.default_pos()
        self.move(x, y)

    def reset_pos(self):
        self.conf.pop("x", None)
        self.conf.pop("y", None)
        self._save_conf()
        self.move(*self.default_pos())

    def on_configure(self, _w, ev):
        if (self.conf.get("x"), self.conf.get("y")) != (ev.x, ev.y):
            self.conf["x"], self.conf["y"] = ev.x, ev.y
            GLib.timeout_add(500, self._save_conf)
        return False

    def _reassert(self):
        self.set_keep_above(True)
        self.stick()
        return True

    def on_press(self, _w, ev):
        if ev.button == 1 and ev.x > self.W - 30 and ev.y < 30:
            self.minimize()
        elif ev.button == 1:
            self.begin_move_drag(ev.button, int(ev.x_root), int(ev.y_root), ev.time)
        elif ev.button == 3:
            self.menu.popup_at_pointer(ev)
        return True

    # ---- data ----
    def tick(self):
        try:
            self.tracker.scan()
            self.models = self.tracker.per_model()
            self.limits = load_limits()
            self.notifier.check(self.limits)
        except Exception as e:
            print("update error:", e)
        h = self.calc_h()
        if h != self.H:
            self.H = h
            self.set_size_request(self.W, h)
            self.resize(self.W, h)
        self.update_tray()
        self.area.queue_draw()
        return True

    # ---- drawing ----
    @staticmethod
    def rrect(cr, x, y, w, h, r):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    @staticmethod
    def text(cr, x, y, s, size, color, bold=False, align="left"):
        cr.select_font_face("Sans", 0, 1 if bold else 0)
        cr.set_font_size(size)
        cr.set_source_rgb(*color)
        if align == "right":
            x -= cr.text_extents(s).x_advance
        cr.move_to(x, y)
        cr.show_text(s)

    def on_draw(self, _w, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        W, H, P = self.W, self.H, 12
        bw = W - 2 * P
        now = time.time()

        self.rrect(cr, 0.5, 0.5, W - 1, H - 1, 11)
        cr.set_source_rgba(*BG, self.conf.get("opacity", DEFAULT_OPACITY))
        cr.fill_preserve()
        cr.set_source_rgba(1, 1, 1, 0.08)
        cr.set_line_width(1)
        cr.stroke()

        # header
        live = any(now - r[3] < LIVE_S for r in self.models)
        cr.set_source_rgb(*(ACCENT if live else DIM))
        cr.arc(P + 3, 17, 3.5, 0, 2 * math.pi)
        cr.fill()
        self.text(cr, P + 12, 21, "Claude usage", 10, DIM, bold=True)
        self.text(cr, W - P - 22, 21, datetime.now().strftime("%H:%M"), 10, DIM, align="right")
        # minimize button
        cr.set_source_rgba(1, 1, 1, 0.07)
        self.rrect(cr, W - P - 14, 9, 16, 16, 4)
        cr.fill()
        cr.set_source_rgb(*FG)
        cr.set_line_width(1.6)
        cr.move_to(W - P - 10, 17.5)
        cr.line_to(W - P - 2, 17.5)
        cr.stroke()

        # limits
        y = 42
        lim = {k: (lbl, p, r) for k, lbl, p, r in (self.limits or ())}
        for key, label in (("five_hour", "5-hour"), ("seven_day", "Weekly")):
            if key in lim:
                _, pct, reset = lim[key]
                c = tray_color(pct)
                self.text(cr, P, y, label, 10, FG, bold=True)
                self.text(cr, P + 52, y, f"{pct:.0f}%", 10, c, bold=True)
                if reset:
                    self.text(cr, W - P, y, f"resets {fmt_dur(reset - now)}", 9, DIM, align="right")
            else:
                c, pct = DIM, 0
                self.text(cr, P, y, label, 10, FG, bold=True)
                self.text(cr, W - P, y, "waiting for Claude Code", 9, DIM, align="right")
            self.rrect(cr, P, y + 5, bw, 6, 3)
            cr.set_source_rgba(1, 1, 1, 0.08)
            cr.fill()
            fw = bw * min(100.0, max(0.0, pct)) / 100.0
            if fw > 0:
                self.rrect(cr, P, y + 5, max(6, fw), 6, 3)
                cr.set_source_rgb(*c)
                cr.fill()
            y += 28

        # per-model tokens today
        cr.set_source_rgba(1, 1, 1, 0.08)
        cr.rectangle(P, y - 8, bw, 1)
        cr.fill()
        today_cost = sum(r[2] for r in self.models)
        all_priced = all(r[4] for r in self.models)
        self.text(cr, P, y + 8, "Today", 10, FG, bold=True)
        self.text(cr, P + 40, y + 8, ("≈ " if all_priced else "≥ ") + fmt_usd(today_cost), 12, ACCENT, bold=True)
        self.text(cr, W - P, y + 8, "tokens · cost", 8, DIM, align="right")
        y += 26
        if not self.models:
            self.text(cr, P, y, "no usage yet today", 10, DIM)
        for name, total, cost, last, priced in self.models[:MAX_MODELS]:
            is_live = now - last < LIVE_S
            cr.set_source_rgb(*(ACCENT if is_live else (0.35, 0.37, 0.41)))
            cr.arc(P + 3, y - 4, 3, 0, 2 * math.pi)
            cr.fill()
            self.text(cr, P + 12, y, name, 10, FG, bold=is_live)
            self.text(cr, W - P - 48, y, fmt(total), 10, FG, bold=True, align="right")
            self.text(cr, W - P, y, fmt_usd(cost) if priced else "n/a", 10, DIM, align="right")
            y += 18


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="local.claude.usage_widget")
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        act = Gio.SimpleAction.new("toggle", None)  # `gapplication action local.claude.usage_widget toggle`
        act.connect("activate", lambda *_: self.win and self.win.toggle())
        self.add_action(act)

    def do_activate(self):
        if self.win is None:
            self.hold()  # keep running while the window is hidden in the tray
            self.win = Widget(self)
        else:
            self.win.restore()  # second launch: bring the widget back


def main():
    import signal
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    App().run(None)


if __name__ == "__main__":
    main()
